{
	"name": "@liminal-hq/spindle-lab",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:debug": "SPINDLE_LAB_MCP_BRIDGE=1 tauri dev --config src-tauri/tauri.dev.conf.json",
		"test": "vitest run",
		"test:ci": "mkdir -p ../../test-results/spindle-lab && vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/spindle-lab/junit.xml",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-dialog": "^2.6.0",
		"@tauri-apps/plugin-fs": "^2.4.5",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-store": "^2.4.2",
		"@tauri-apps/plugin-window-state": "^2.4.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"@vitest/coverage-v8": "^4.1.9",
		"happy-dom": "^20.8.4",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vitest": "^4.1.9"
	}
}
