{
	"name": "@liminal-hq/spindle-lab-workspace",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": "24.14.0",
		"pnpm": "10.32.1"
	},
	"scripts": {
		"build": "pnpm --filter @liminal-hq/spindle-lab build",
		"ci:all": "pnpm validate",
		"dev": "pnpm --filter @liminal-hq/spindle-lab dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"tauri": "pnpm --filter @liminal-hq/spindle-lab tauri",
		"test:js": "pnpm --filter @liminal-hq/spindle-lab test",
		"test:js:ci": "pnpm --filter @liminal-hq/spindle-lab test:ci",
		"test:rust": "cargo nextest run --workspace --locked",
		"test:rust:ci": "mkdir -p test-results/rust && cargo nextest run --workspace --locked --config-file nextest.toml --profile ci",
		"validate": "pnpm format:check && pnpm lint && pnpm test:js:ci && pnpm build && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && pnpm test:rust:ci"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"eslint": "^9.0.0",
		"globals": "^15.0.0",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.0.0"
	}
}
